---
import Layout from "../layouts/Layout.astro";
import { getSession } from "../lib/session";
import { getUserBySlackId, getShopItems } from "../lib/airtable";

const session = await getSession(Astro.cookies, import.meta.env.SESSION_SECRET);
if (!session) return Astro.redirect("/auth/login");

const userRecord = await getUserBySlackId(session.slack_id);
const hackatimeConnected = !!userRecord?.hackatime_token;

const raspberryBalance = userRecord?.balance ?? 0;

const adminIds = (import.meta.env.ADMIN_IDS ?? "")
	.split(",")
	.map((s: string) => s.trim())
	.filter(Boolean);
const isAdmin = adminIds.includes(session.slack_id);

const shopItems = await getShopItems();
---

<Layout>
  <main class="page">
    <header class="topbar">
      <div class="profile">
        <img
          class="avatar"
          alt="avatar"
          data-slack-id={session.slack_id}
          style="visibility:hidden"
        />
        <p class="name" data-slack-id={session.slack_id}>&nbsp;</p>
      </div>
      <div class="actions">
        <a href="/projects" class="logout"> my projects </a>
        {
          isAdmin && (
            <>
              <a href="/review" class="logout">
                review
              </a>
              <a href="/admin/fulfillment" class="logout">
                fulfillment
              </a>
              <a href="/admin/users" class="logout">
                admin
              </a>
            </>
          )
        }
        {
          hackatimeConnected ? (
            <span class="hackatime-status">hackatime connected</span>
          ) : (
            <a href="/auth/hackatime" class="logout">
              connect hackatime
            </a>
          )
        }
        <a href="/auth/logout" class="logout">sign out</a>
        {userRecord?.row_number && (
          <button class="referral-copy" id="referral-copy-btn"
            data-url={`${import.meta.env.PUBLIC_BASE_URL}/?r=${userRecord.row_number}`}>
            copy referral
          </button>
        )}
      </div>
    </header>

    <section class="shop">
      <div class="shop-header">
        <span class="shop-label">SHOP</span>
        <span class="balance">{raspberryBalance} raspberries</span>
      </div>

      {
        shopItems.length === 0 ? (
          <p class="empty">no items available</p>
        ) : (
          <div class="grid">
            {shopItems.map((item) => {
              const canAfford = raspberryBalance >= item.price;
              return (
                <div class={`item${item.priority ? " item--priority" : ""}`}>
                  <div class="item-image">
                    {item.imageUrl ? (
                      <img src={item.imageUrl} alt={item.name} />
                    ) : (
                      <span class="fallback">🍓</span>
                    )}
                  </div>
                  <div class="item-info">
                    <div>
                      <p class={`item-name${item.priority ? " item-name--priority" : ""}`}>{item.name}</p>
                      {item.description && (
                        <p class="item-desc">{item.description}</p>
                      )}
                    </div>
                    <div class="item-footer">
                      <p class={`item-price${item.priority ? " item-price--priority" : ""}`}>{item.price} raspberries</p>
                      <button
                        class="btn-buy"
                        data-item-id={item.id}
                        data-item-name={item.name}
                        data-item-price={item.price}
                        disabled={!canAfford}
                      >
                        {canAfford ? "buy" : "not enough"}
                      </button>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        )
      }
    </section>
  </main>

  <style>
    .page {
      min-height: 100vh;
      padding: 2rem 2.5rem;
      display: flex;
      flex-direction: column;
      gap: 3rem;
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-left: 7rem;
    }

    .profile {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      object-fit: cover;
      background: #1a1a1a;
      flex-shrink: 0;
    }

    .name {
      font-family: "Syne", sans-serif;
      font-weight: 800;
      font-size: 1rem;
      color: #f5f5f5;
      margin: 0;
    }

    .actions {
      display: flex;
      gap: 1rem;
    }

    .logout {
      font-size: 0.75rem;
      color: #525252;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .hackatime-status {
      font-size: 0.75rem;
      color: #525252;
    }

    .referral-copy {
      font-size: 0.75rem;
      color: #525252;
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .referral-copy.copied {
      color: #f5f5f5;
    }

    .shop {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .shop-header {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    .shop-label {
      font-family: "Syne", sans-serif;
      font-weight: 800;
      font-size: 0.65rem;
      letter-spacing: 0.5em;
      color: #c41e3a;
    }

    .balance {
      font-family: "Syne", sans-serif;
      font-weight: 700;
      font-size: 0.75rem;
      color: #525252;
    }

    .empty {
      font-size: 0.875rem;
      color: #525252;
      margin: 0;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1px;
      border: 1px solid #262626;
    }

    .item {
      display: flex;
      flex-direction: column;
      border-right: 1px solid #262626;
      border-bottom: 1px solid #262626;
      margin-right: -1px;
      margin-bottom: -1px;
    }

    .item-image {
      width: 100%;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      background: #111;
      flex-shrink: 0;
    }

    .item-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .fallback {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 4rem;
    }

    .item-info {
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 0.75rem;
      flex: 1;
    }

    .item-name {
      font-family: "Syne", sans-serif;
      font-weight: 700;
      font-size: 1rem;
      color: #f5f5f5;
      margin: 0 0 0.35rem 0;
    }

    .item-desc {
      font-size: 0.85rem;
      color: #737373;
      margin: 0;
      line-height: 1.5;
    }

    .item--priority {
      border-color: #b8860b;
    }

    .item-name--priority {
      color: #ffd700;
    }

    .item-price {
      font-size: 0.8rem;
      color: #c41e3a;
      margin: 0;
      font-family: "Syne", sans-serif;
      font-weight: 700;
    }

    .item-price--priority {
      color: #ffd700;
    }

    .item-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .btn-buy {
      font-size: 0.7rem;
      font-family: "Syne", sans-serif;
      font-weight: 700;
      background: none;
      border: 1px solid #c41e3a;
      color: #c41e3a;
      padding: 0.25rem 0.75rem;
      cursor: pointer;
      white-space: nowrap;
    }

    .btn-buy:hover:not(:disabled) {
      background: #c41e3a;
      color: #f5f5f5;
    }

    .btn-buy:disabled {
      opacity: 0.4;
      cursor: not-allowed;
      border-color: #525252;
      color: #525252;
    }
  </style>

  <script>
    const copyBtn = document.getElementById("referral-copy-btn") as HTMLButtonElement | null;
    if (copyBtn) {
      copyBtn.addEventListener("click", () => {
        navigator.clipboard.writeText(copyBtn.dataset.url ?? "").then(() => {
          copyBtn.textContent = "copied!";
          copyBtn.classList.add("copied");
          setTimeout(() => {
            copyBtn.textContent = "copy referral";
            copyBtn.classList.remove("copied");
          }, 1500);
        });
      });
    }

    document.querySelectorAll<HTMLButtonElement>(".btn-buy").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const itemId = btn.dataset.itemId;
        const itemName = btn.dataset.itemName;
        const itemPrice = btn.dataset.itemPrice;
        if (!itemId) return;

        if (!confirm(`Buy "${itemName}" for ${itemPrice} raspberries?`)) return;

        btn.disabled = true;
        btn.textContent = "buying...";

        try {
          const res = await fetch("/api/shop/buy", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ item_id: itemId }),
          });
          const data = await res.json();
          if (!res.ok) {
            alert(data.error || "Purchase failed");
            btn.disabled = false;
            btn.textContent = "buy";
            return;
          }
          btn.textContent = "purchased!";
          const balanceEl = document.querySelector(".balance");
          if (balanceEl) balanceEl.textContent = `${data.new_balance} raspberries`;
          setTimeout(() => location.reload(), 1000);
        } catch {
          alert("Network error");
          btn.disabled = false;
          btn.textContent = "buy";
        }
      });
    });

    const id =
      document.querySelector<HTMLElement>("[data-slack-id]")?.dataset.slackId;
    if (id) {
      fetch(`https://cachet.dunkirk.sh/users/${id}`)
        .then((r) => (r.ok ? r.json() : null))
        .then((d) => {
          if (!d) return;
          const img =
            document.querySelector<HTMLImageElement>("img[data-slack-id]");
          if (img && d.imageUrl) {
            img.src = d.imageUrl;
            img.style.visibility = "visible";
          }
          const name = document.querySelector<HTMLElement>(
            ".name[data-slack-id]",
          );
          if (name && d.displayName) name.textContent = d.displayName;
        })
        .catch(() => {});
    }
  </script>
</Layout>
